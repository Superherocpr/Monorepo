{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:tz": "for tz in UTC America/New_York America/Los_Angeles Asia/Tokyo Australia/Sydney; do echo \"── TZ=$tz\"; TZ=$tz vitest run tests/unit/lib/business-time.test.ts tests/unit/lib/enrollware-bookmarklet.test.ts || exit 1; done",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1034.0",
    "@paypal/react-paypal-js": "^9.1.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@types/sanitize-html": "^2.16.1",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "next": "^16.3.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.0.6",
    "recharts": "^3.8.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "resend": "^6.12.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
