# ==============================================================================
# Superhero CPR — Environment Variables Master List
# ==============================================================================
# This file documents every environment variable required across the stack.
# Copy this to .env.local for development. Never commit .env.local to version control.
#
# ENVIRONMENTS:
#   .env.local         — Local development (http://localhost:3000)
#   .env.staging       — Staging reference (https://staging.superherocpr.com)
#                        Do not commit — keep locally or manage via Amplify console
#   Production vars    — Set directly in AWS Amplify console for the main branch
#
# Variables that DIFFER between environments are marked: [ENV-SPECIFIC]
# Variables that are the SAME in all environments are marked: [SHARED]
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. General / App
# ------------------------------------------------------------------------------
# [ENV-SPECIFIC] Each environment has its own base URL.
# Development: http://localhost:3000
# Staging:     https://staging.superherocpr.com  (or Amplify-generated URL)
# Production:  https://superherocpr.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 2. Supabase (Database & Auth)
# ------------------------------------------------------------------------------
# [ENV-SPECIFIC] Each environment uses a completely separate Supabase project.
# Staging and production must never share a database.
# Get from: Supabase Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER-SIDE ONLY. NEVER expose this to the client.
# Used for: Admin API routes that bypass RLS (e.g. creating auth users, restoring accounts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ------------------------------------------------------------------------------
# 3. Resend (Transactional Email)
# ------------------------------------------------------------------------------
# All system emails go through Resend EXCEPT contact form replies (Zoho, see below).
# Get from: resend.com > API Keys

# [SHARED] Same API key works across environments. Resend does not have a sandbox
# mode that captures emails — use a staging from-address to distinguish.
RESEND_API_KEY=re_123456789

# [ENV-SPECIFIC] Use a staging from-address so test emails are clearly distinguishable.
# Development/Staging: Superhero CPR Staging <noreply@staging.superherocpr.com>
# Production:          Superhero CPR <noreply@superherocpr.com>
# Note: Both domains must be verified in your Resend account.
RESEND_FROM_EMAIL=Superhero CPR <noreply@superherocpr.com>


# ------------------------------------------------------------------------------
# 4. PayPal — Bookings, Invoices & Instructor Payouts
# ------------------------------------------------------------------------------
# [ENV-SPECIFIC] Use PayPal Sandbox for local testing only if you are testing
# sandbox payments. Live deployments must use the live PayPal REST API base.
# These are the SuperHeroCPR business REST app credentials. Customers pay this
# business account; instructor compensation is sent later through PayPal Payouts.

NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret

# [ENV-SPECIFIC] Production/live:
PAYPAL_API_BASE=https://api-m.paypal.com
# Sandbox, when intentionally testing sandbox PayPal:
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# [ENV-SPECIFIC] Webhook ID for the business PayPal account's
# INVOICING.INVOICE.PAID webhook subscription (PayPal business dashboard >
# Apps & Credentials > Webhooks). Must be subscribed to at least
# INVOICING.INVOICE.PAID, pointed at
# {NEXT_PUBLIC_BASE_URL}/api/webhooks/paypal-invoice. Used by
# lib/paypal.ts verifyPayPalWebhookSignature() to authenticate inbound
# webhook requests — without it, the webhook route rejects everything.
# This is separate from PAYPAL_WEBHOOK_ID (used by a different, pre-existing
# webhook subscription on this account) — each webhook subscription is
# scoped to its own target URL and gets its own unique ID from PayPal, so
# the two must not share a value.
PAYPAL_INVOICE_WEBHOOK_ID=your-paypal-invoice-webhook-id

# Optional fallback if system_settings.platform_fee_percent is missing.
PLATFORM_FEE_PERCENT=20


# ------------------------------------------------------------------------------
# 5. Zoho Mail (Contact Form Replies)
# ------------------------------------------------------------------------------
# Used ONLY for replying to contact form submissions at /admin/contact.
# All other emails go through Resend.
# Note: Access/refresh tokens are stored in the system_settings DB table after OAuth.
#       These vars are only needed to initiate the OAuth flow from /admin/settings.
# Get from: api-console.zoho.com > Server-based Application

# [ENV-SPECIFIC] Register staging redirect URI in the Zoho API console.
# Staging:    https://staging.superherocpr.com/api/contact/zoho-callback
# Production: https://superherocpr.com/api/contact/zoho-callback
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=https://superherocpr.com/api/contact/zoho-callback


# ------------------------------------------------------------------------------
# 6. AWS S3 (File Storage)
# ------------------------------------------------------------------------------
# Used for: Roster file uploads (/submit-roster) and product images (/admin/merch).
# Get from: AWS IAM Console — create a dedicated IAM user with S3 permissions only.

# [SHARED] Same IAM credentials work for both buckets if the IAM user has access to both.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# [ENV-SPECIFIC] Staging uses a separate S3 bucket.
# Staging:    superherocpr-assets-staging
# Production: superherocpr-assets
AWS_S3_BUCKET_NAME=superherocpr-assets


# ------------------------------------------------------------------------------
# 10. Twilio (SMS)
# ------------------------------------------------------------------------------
# [ENV-SPECIFIC] Twilio provides test credentials that do not send real SMS.
# Test credentials: twilio.com/console > Settings > Test Credentials
# Use test credentials for development and staging.

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15550000000


# ------------------------------------------------------------------------------
# 11. Merch
# ------------------------------------------------------------------------------
# [SHARED] Shipping rate is a business decision — same across environments.
# Exposed to the client so the cart can display it before checkout.
NEXT_PUBLIC_SHIPPING_RATE=0


# ------------------------------------------------------------------------------
# 12. Enrollware (Browser Extension)
# ------------------------------------------------------------------------------
# No API keys required. The Enrollware browser extension authenticates using
# the instructor's existing Supabase session — no separate credentials needed.
# The extension calls internal API routes at /api/enrollware/*.
# No variables required here.
